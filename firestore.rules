rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // HELPER FUNCTIONS
    // =====================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization:
    // Never trust client-editable document fields for admin authorization.
    // Relies solely on Firebase Auth Custom Claims set by an administrative backend.
    // If custom claims are not yet provisioned, admin-only access is safely denied.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    // Ensures protected fields are completely immutable on update:
    // Users cannot add, remove, or change the 'role' field, document 'id', or creation timestamps.
    function notModifyingProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'id', 'createdAt', 'created_at']);
    }

    // =====================================================================
    // COLLECTION RULES
    // =====================================================================

    // 1. User Profiles: users/{userId}
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Profile Creation:
      // Must be owner, id must match userId, and role cannot be 'admin' (defaults to 'pet_parent')
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'pet_parent');

      // Profile Updates:
      // Users can update profile fields, but 'role' is strictly immutable (cannot add, remove, or change it),
      // and system fields (id, createdAt) cannot be altered.
      allow update: if (isOwner(userId) && notModifyingProtectedFields())
        || isAdmin();

      // Account deletion restricted to admins
      allow delete: if isAdmin();

      // 2. Nested Pets Subcollection: users/{userId}/pets/{petId}
      match /pets/{petId} {
        allow read, write: if isOwner(userId) || isAdmin();

        // Nested Pet Medical Records: users/{userId}/pets/{petId}/medical_records/{recordId}
        match /medical_records/{recordId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }
      }

      // 3. Nested Medical Records (User-level): users/{userId}/medical_records/{recordId}
      match /medical_records/{recordId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // 4. Default: Deny all access to unsupported or unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
